---
import AboutSection from "./AboutSection.astro";
import TechnologiesSection from "./TechnologiesSection.astro";
import SkillsSection from "./SkillsSection.astro";
import ProjectsSection from "./ProjectsSection.astro";
---

<article id="main">
  <AboutSection />
  <TechnologiesSection />
  <SkillsSection />
  <ProjectsSection />
</article>

<style>
/* Section/Article */

section.special, article.special {
    text-align: center;
}

header.major {
    padding-bottom: 2em;
}

footer > :last-child {
    margin-bottom: 0;
}

footer.major {
    padding-top: 3em;
}


</style>
